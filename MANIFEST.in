# sdist payload: the contract, the shipped profile, the complete test tree,
# and the public documentation site sources.
include README.md
include SPEC.md
include LICENSE
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include CODE_OF_CONDUCT.md
include PUBLISHING.md
include mkdocs.yml
recursive-include wpt/data *.json
recursive-include docs *.md *.svg *.png *.css
recursive-include scripts *.py
recursive-include tests *.py
recursive-include wpt *.php
global-exclude __pycache__ *.py[cod]
